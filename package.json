{
  "name": "mini-proyecto-2-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npx ts-add-js-extension --dir=dist",
    "prod": "node dist/src/index.js",
    "deploy": "prisma db push",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:reset:seed": "prisma db push --force-reset && tsx src/scripts/seed.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "generate:excel:plantillas": "tsx src/scripts/generate-excel-plantillas.ts",
    "limpieza:r2": "tsx src/scripts/limpieza-r2.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "prisma": "^6.0.0",
    "ts-add-js-extension": "^1.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
